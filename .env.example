# Seam driver selection — whitelabel MVNO self-care. (Spec Fase 0.4)
#
# Each seam picks its driver from these flags. Default (no .env) is "mock" for every seam,
# so the demo runs with zero config. Flip a flag to "http" only when the real endpoint exists
# (CPR first — Fase 8). Vite exposes VITE_*-prefixed vars to the client via import.meta.env.
#
# CPR is the ONLY system intended to go real; ECM/EOC/ECEV/DSIMA stay mock for the demo.

VITE_CPR_DRIVER=mock          # mock | http   (real Customer/Party Repository)
VITE_ECM_DRIVER=mock          # mock | http   (catalog — TMF620/679)
VITE_EOC_DRIVER=mock          # mock | http   (order / installed base — TMF663/622/637)
VITE_ECEV_DRIVER=mock         # mock | http   (charging / balance — TMF654)
VITE_RESOURCE_DRIVER=mock     # mock | http   (DSIMA — SIM/MSISDN select & reserve)
# AUTH is special: the mock login accepts any credential, so a PROD build FORBIDS the mock
# (authDriverOrThrow throws). CI must set this to "http" for production. "mock" is fine in dev.
VITE_AUTH_DRIVER=mock         # mock | http   (auth — Keycloak OIDC stub in auth-http.ts)

# CPR over http goes through the same-origin BFF (/bff/cpr), which holds the token SERVER-side.
# The CLIENT needs only the driver flag + its brand — NO token, NO real base URL:
# VITE_CPR_DRIVER=http        # (set above) route CPR through the BFF
# VITE_CPR_ACTIVE_BRAND=drei  # the brand this build acts as, for the customer360 read
#                             # (getCustomerAndParty carries no tenant). MUST match the build's
#                             # brand under http, or getCustomer360's cross-tenant check rejects
#                             # EVERY 360 as notFound. Defaults to "drei"; boot warns if unset/invalid.
# VITE_CPR_BASE_URL=          # optional override of the BFF prefix (default /bff/cpr); for tests only.
#
# ⚠️ DO NOT set VITE_CPR_TOKEN. The token moved server-side — a VITE_ token would ship to the
#    client and undo the BFF, so assertDriverConfig THROWS if it is set under the http driver.
#
# SERVER-ONLY (NOT VITE_ — never bundled to the client; the BFF reads these from the Worker env,
# i.e. Cloudflare vars/secrets in prod, `.dev.vars` / shell env in dev):
#   CPR_BASE_URL=<real CPR or the local fake>   # the BFF's upstream
#   CPR_TOKEN=<the CPR bearer token>            # injected by the BFF; never seen by the browser
#   CPR_TENANT_DREI=TEN_FAKE                     # brand → DXP tenant map (placeholder; real map TBD)
#   CPR_TENANT_DREIGO=TEN_FAKE
#
# ── Recharge (prepaid top-up over ECEV/charging) — cpr-recharge spec ────────────────────────────
# Recharge goes real through its OWN same-origin BFF (/bff/recharge), same token-server-side shape
# as CPR. The CLIENT needs only the driver flag + the SAME active-brand var as CPR — NO token:
# VITE_ECEV_DRIVER=http       # (set above) route recharge (payment capture + monetaryRecharge) real
#                             # Flips BOTH credit sites: the standalone top-up AND onboarding's first
#                             # credit. Mock (default) is unchanged — the demo/CI needs no config.
# VITE_CPR_ACTIVE_BRAND=drei  # recharge REUSES this (not a new var): charging-http sends it as the
#                             # X-App-Brand header → the BFF resolves the DXP X-Tenant-ID. One app
#                             # build = one brand, shared by CPR and recharge. Boot warns if unset
#                             # while CPR or recharge is http.
#
# ⚠️ DO NOT set VITE_ECEV_TOKEN. Like CPR, the recharge token lives server-side — a VITE_ token would
#    ship to the client and undo the BFF, so assertDriverConfig THROWS if it is set under ECEV http.
#
#   RECHARGE_BASE_URL=<real charging or the local fake>  # the recharge BFF's upstream
#   RECHARGE_TOKEN=<the charging bearer token>           # injected by the BFF; never on the browser.
#                                                        # Static for the fake; a real OAuth2
#                                                        # client-credentials grant is a follow-up.
#   # Recharge REUSES the CPR_TENANT_* map above (no RECHARGE_TENANT_*): the reference Postman sends
#   # the same X-Tenant-ID on both Customer and Recharge calls — tenant is the CSP/brand identity,
#   # not per-domain. Two maps could drift and route a recharge to the wrong tenant.
#
# Boot fail-fast (assertDriverConfig, called from getRouter): a PROD build with CPR on "mock" logs a
# structured config-warning (demo data served as real). AUTH hard-fails on mock in PROD
# (authDriverOrThrow). The BFF validates its own server config at request time → a 503 envelope.
