# Seam driver selection — whitelabel MVNO self-care. (Spec Fase 0.4)
#
# Each seam picks its driver from these flags. Default (no .env) is "mock" for every seam,
# so the demo runs with zero config. Flip a flag to "http" only when the real endpoint exists
# (CPR first — Fase 8). Vite exposes VITE_*-prefixed vars to the client via import.meta.env.
#
# CPR is the ONLY system intended to go real; ECM/EOC/ECEV/DSIMA stay mock for the demo.

VITE_CPR_DRIVER=mock          # mock | http   (real Customer/Party Repository)
VITE_ECM_DRIVER=mock          # mock | http   (catalog — TMF620/679)
VITE_EOC_DRIVER=mock          # mock | http   (order / installed base — TMF663/622/637)
VITE_ECEV_DRIVER=mock         # mock | http   (charging / balance — TMF654)
VITE_RESOURCE_DRIVER=mock     # mock | http   (DSIMA — SIM/MSISDN select & reserve)
# AUTH is special: the mock login accepts any credential, so a PROD build FORBIDS the mock
# (authDriverOrThrow throws). CI must set this to "http" for production. "mock" is fine in dev.
VITE_AUTH_DRIVER=mock         # mock | http   (auth — Keycloak OIDC stub in auth-http.ts)

# When a driver is "http", its client reads the base URL + token from these (Fase 8):
# VITE_CPR_BASE_URL=          # SAFETY RAIL: while VITE_CPR_TOKEN ships to the client, this MUST be
#                             # localhost/127.0.0.1 (the local fake). assertDriverConfig THROWS on a
#                             # non-local host — no real host until auth moves server-side (BFF).
# VITE_CPR_TOKEN=             # client-side token — fake only. A real token belongs on a BFF, not here.
#
# Brand → DXP tenant id sent as X-Tenant-ID (brand slug != DXP tenant like TEN100000200008).
# Placeholder TEN_FAKE until the real map is provided (the fake accepts any value).
# VITE_CPR_TENANT_DREI=TEN_FAKE
# VITE_CPR_TENANT_DREIGO=TEN_FAKE
#
# The brand this build acts as, for the customer360 read (getCustomerAndParty carries no tenant).
# MUST match the build's brand when VITE_CPR_DRIVER=http: a mismatch makes getCustomer360's
# cross-tenant check reject EVERY 360 as notFound. Defaults to "drei"; boot warns if unset/invalid.
# VITE_CPR_ACTIVE_BRAND=drei
#
# Boot fail-fast (assertDriverConfig, called from getRouter): if VITE_CPR_DRIVER=http but
# VITE_CPR_BASE_URL/TOKEN are unset, startup THROWS (incoherent deploy) rather than failing every
# call at runtime. In a PROD build, a real-able seam (CPR) left on "mock" logs a structured
# config-warning (demo data served as real) — a warning today, a hard failure once the CPR http
# driver is production-ready (Fase 8). AUTH already hard-fails on mock in PROD (authDriverOrThrow).
